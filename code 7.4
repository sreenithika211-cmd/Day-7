from machine import Pin, I2C
import dht
from time import sleep


# =========================
# DHT22 SENSOR
# =========================

dht_sensor = dht.DHT22(Pin(4))


# =========================
# I2C LCD
# =========================

i2c = I2C(
    0,
    scl=Pin(22),
    sda=Pin(21),
    freq=400000
)

LCD_ADDR = 0x27


# =========================
# LCD FUNCTIONS
# =========================

LCD_BACKLIGHT = 0x08
ENABLE = 0x04


def lcd_write(data):
    i2c.writeto(
        LCD_ADDR,
        bytes([data | LCD_BACKLIGHT])
    )


def lcd_pulse(data):
    lcd_write(data | ENABLE)
    sleep(0.001)
    lcd_write(data & ~ENABLE)
    sleep(0.001)


def lcd_command(cmd):
    high = cmd & 0xF0
    low = (cmd << 4) & 0xF0

    lcd_pulse(high)
    lcd_pulse(low)


def lcd_data(data):
    high = (data & 0xF0) | 0x01
    low = ((data << 4) & 0xF0) | 0x01

    lcd_pulse(high)
    lcd_pulse(low)


def lcd_init():
    sleep(0.05)

    lcd_command(0x33)
    lcd_command(0x32)
    lcd_command(0x28)
    lcd_command(0x0C)
    lcd_command(0x06)
    lcd_command(0x01)

    sleep(0.005)


def lcd_clear():
    lcd_command(0x01)
    sleep(0.002)


def lcd_set_cursor(row, col):
    if row == 0:
        address = 0x80 + col
    else:
        address = 0xC0 + col

    lcd_command(address)


def lcd_print(text):
    for char in text:
        lcd_data(ord(char))


# =========================
# START LCD
# =========================

lcd_init()

lcd_clear()
lcd_set_cursor(0, 0)
lcd_print("DHT22 SENSOR")

lcd_set_cursor(1, 0)
lcd_print("Starting...")

sleep(2)


# =========================
# MAIN LOOP
# =========================

while True:

    try:

        dht_sensor.measure()

        temperature = dht_sensor.temperature()
        humidity = dht_sensor.humidity()

        print("--------------------")
        print("Temperature:", temperature, "C")
        print("Humidity:", humidity, "%")

        # LCD
        lcd_clear()

        lcd_set_cursor(0, 0)
        lcd_print("Temp: ")
        lcd_print(str(temperature))
        lcd_print(" C")

        lcd_set_cursor(1, 0)
        lcd_print("Hum : ")
        lcd_print(str(humidity))
        lcd_print(" %")

    except Exception as error:

        print("Sensor Error:", error)

        lcd_clear()

        lcd_set_cursor(0, 0)
        lcd_print("Sensor Error")

        lcd_set_cursor(1, 0)
        lcd_print("Check DHT22")

    # Read every 2 seconds
    sleep(2)
